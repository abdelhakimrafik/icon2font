{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "lib": ["es6", "dom"],
    "typeRoots": ["./node_modules/@figma"],
    "paths": {
      "@common/*": ["./src/common/*"],
      "@ui/*": ["./src/ui/*"],
      "@plugin/*": ["./src/plugin/*"]
    }
  }
}
