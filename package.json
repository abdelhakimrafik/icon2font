{
  "name": "icon2font",
  "version": "2.0.1",
  "description": "Figma plugin to export icons to font",
  "main": "dist/plugin.js",
  "type": "module",
  "scripts": {
    "dev": "run-p 'watch:*'",
    "dev:ui": "vite -c ./vite.config.ui.ts",
    "watch:ui": "npm run build:ui -- --watch --mode=development",
    "watch:plugin": "npm run build:plugin -- --watch --mode=development",
    "build": "run-s 'build:*'",
    "prebuild": "run-s types clean",
    "build:ui": "vite build -c ./vite.config.ui.ts",
    "build:plugin": "vite build -c ./vite.config.plugin.ts",
    "clean": "rimraf dist/*",
    "types": "run-s 'types:*'",
    "types:src": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "author": {
    "name": "Abdelhakim RAFIK",
    "email": "ra.abdelhakim@gmail.com",
    "url": "https://www.abdelhakimrafik.com"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@figma/plugin-typings": "^1.100.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.22.5",
    "sass": "^1.79.4",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vite-plugin-generate-file": "^0.2.0",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.1"
  },
  "license": "MIT",
  "packageManager": "yarn@4.5.0"
}
